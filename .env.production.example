# Shared production configuration for Docker Compose, the FastAPI API, and Nginx.
# Copy to .env.production, replace every example value, then use:
# docker compose --env-file .env.production up --build -d
APP_ENV=production
APP_NAME=WedLens API
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# Bind only the frontend publicly. Place it behind a TLS reverse proxy before
# exposing the application to the internet.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Replace with the externally visible, HTTPS frontend origin.
CORS_ORIGINS=https://photos.example.com
API_UPSTREAM=http://backend:8000

# Replace this password. A deployment secret manager may inject this value
# instead of storing it in .env.production.
POSTGRES_DB=wedlens
POSTGRES_USER=wedlens
POSTGRES_PASSWORD=replace-with-a-strong-production-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
