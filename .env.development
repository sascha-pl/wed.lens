# Shared development configuration for Docker Compose, the FastAPI API, and Vite.
# Use with: docker compose --env-file .env.development up --build
APP_ENV=local
APP_NAME=WedLens API
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# Public development endpoints.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=5173
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Browser-facing API settings.
CORS_ORIGINS=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:8000
API_UPSTREAM=http://backend:8000

# PostgreSQL service and backend connection. The backend derives DATABASE_URL
# from these values, so the password is defined only once.
POSTGRES_DB=wedlens
POSTGRES_USER=wedlens
# This development-only password is intentionally not a production secret.
POSTGRES_PASSWORD=wedlens-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
